{
  "manifest_version": 3,
  "name": "YouTube Original 5.1",
  "version": "2026.10.26",
  "description": "YouTubeの元の5.1ch音声をHRTFヘッドホン／Windows空間オーディオで再生。",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "native-bridge.js"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tv_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; frame-src 'self'; worker-src 'self'; connect-src 'self' https://www.youtube.com https://*.googlevideo.com;",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; child-src 'none'; connect-src 'none'; object-src 'none';"
  },
  "sandbox": {
    "pages": [
      "solver.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "processor.html",
        "processor.js",
        "decoder-worker.js",
        "solver.html",
        "solver.js",
        "vendor/*"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "segmented-audio.js",
        "atmos-renderer.js",
        "mute-recovery.js",
        "controller.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "version_name": "2026-10-26"
}
